APP_NAME=HospitalPrivado
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080

# Si usas una base de datos fuera de Docker, deja tus credenciales reales
# en .env (raiz) o crea un .env dedicado para Docker a partir de este ejemplo.
DB_CONNECTION=mysql
DB_HOST=tu-host-db
DB_PORT=3306
DB_DATABASE=tu_base
DB_USERNAME=tu_usuario
DB_PASSWORD=tu_password
